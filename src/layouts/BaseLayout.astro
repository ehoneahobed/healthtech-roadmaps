---
import '../styles/global.css';
import { inject } from '@vercel/analytics';

inject();

interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <slot name="meta" />
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-PXX0MQ1PFR"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-PXX0MQ1PFR');
    </script>
  </head>
  <body class="antialiased">
    <!-- Header -->
    <header class="border-b border-surface-100 sticky top-0 z-40 bg-white">
      <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
        <a href="/" class="flex items-center gap-3 no-underline hover:opacity-80 transition-opacity">
          <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-brand-500 to-brand-600 flex items-center justify-center">
            <span class="text-white font-bold text-sm">H</span>
          </div>
          <div class="flex flex-col">
            <h1 class="text-lg font-semibold text-surface-900 m-0">Health Tech Roadmaps</h1>
            <p class="text-xs text-surface-600 m-0">by Ehoneah</p>
          </div>
        </a>

        <nav class="flex items-center gap-6">
          <a
            href="/stories"
            class="text-sm font-medium text-surface-700 hover:text-brand-600 transition-colors hidden sm:inline"
          >
            Stories
          </a>
          <a
            href="/contribute"
            class="text-sm font-medium text-surface-700 hover:text-brand-600 transition-colors hidden sm:inline"
          >
            Contribute
          </a>
          <a
            href="https://quiz.ehoneahobed.com"
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm font-medium text-surface-700 hover:text-brand-600 transition-colors hidden sm:inline"
          >
            Take the Quiz
          </a>
          <a
            href="https://thetransmutation.substack.com"
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm font-medium text-surface-700 hover:text-brand-600 transition-colors hidden sm:inline"
          >
            Newsletter
          </a>
          <a
            href="https://youtube.com/@ehoneah"
            target="_blank"
            rel="noopener noreferrer"
            class="text-surface-700 hover:text-red-600 transition-colors"
            aria-label="YouTube"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
          </a>
        </nav>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-surface-100 bg-surface-50 mt-16">
      <div class="max-w-6xl mx-auto px-6 py-12">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
          <div>
            <h3 class="text-sm font-semibold text-surface-900 mb-4">Resources</h3>
            <ul class="space-y-2">
              <li>
                <a
                  href="https://thetransmutation.substack.com"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-sm text-surface-600 hover:text-brand-600 transition-colors"
                >
                  The Transmutation Newsletter
                </a>
              </li>
              <li>
                <a
                  href="https://quiz.ehoneahobed.com"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-sm text-surface-600 hover:text-brand-600 transition-colors"
                >
                  Career Transition Quiz
                </a>
              </li>
              <li>
                <a
                  href="https://ehoneahobed.gumroad.com/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-sm text-surface-600 hover:text-brand-600 transition-colors"
                >
                  Gumroad Reports
                </a>
              </li>
              <li>
                <a
                  href="https://youtube.com/@ehoneah"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-sm text-surface-600 hover:text-brand-600 transition-colors"
                >
                  YouTube Channel
                </a>
              </li>
              <li>
                <a
                  href="/contribute"
                  class="text-sm text-surface-600 hover:text-brand-600 transition-colors"
                >
                  Share Your Story
                </a>
              </li>
            </ul>
          </div>

          <div>
            <h3 class="text-sm font-semibold text-surface-900 mb-4">About</h3>
            <p class="text-sm text-surface-600">
              Research-backed transition guides for healthcare professionals moving into tech. Built by a pharmacist who made the switch.
            </p>
          </div>

          <div>
            <h3 class="text-sm font-semibold text-surface-900 mb-4">Connect</h3>
            <div class="flex items-center gap-4">
              <a
                href="https://youtube.com/@ehoneah"
                target="_blank"
                rel="noopener noreferrer"
                class="text-surface-500 hover:text-red-600 transition-colors"
                aria-label="YouTube"
              >
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                </svg>
              </a>
              <a
                href="https://thetransmutation.substack.com"
                target="_blank"
                rel="noopener noreferrer"
                class="text-surface-500 hover:text-brand-600 transition-colors"
                aria-label="Newsletter"
              >
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </a>
            </div>
          </div>
        </div>

        <div class="border-t border-surface-200 pt-8 flex items-center justify-between">
          <p class="text-sm text-surface-500">
            &copy; {new Date().getFullYear()} Health Tech Roadmaps. All rights reserved.
          </p>
          <p class="text-sm text-surface-500">
            Designed for the modern healthcare professional.
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
