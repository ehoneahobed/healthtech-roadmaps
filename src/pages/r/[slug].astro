---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EmailCapture from '../../components/EmailCapture.tsx';
import { getAllRoadmaps } from '../../lib/roadmaps';
import type { Roadmap } from '../../content/schema';

export function getStaticPaths() {
  const roadmaps = getAllRoadmaps();
  return roadmaps.map((roadmap) => ({
    params: { slug: roadmap.meta.slug },
    props: { roadmap },
  }));
}

const { roadmap } = Astro.props as { roadmap: Roadmap };
const { meta, sections, sources } = roadmap;

const difficultyColors: Record<string, string> = {
  low: 'bg-emerald-100 text-emerald-700',
  moderate: 'bg-amber-100 text-amber-700',
  high: 'bg-orange-100 text-orange-700',
  'very-high': 'bg-red-100 text-red-700',
};

const signalColors: Record<string, string> = {
  high: 'border-emerald-300 bg-emerald-50',
  helpful: 'border-amber-300 bg-amber-50',
  skip: 'border-gray-300 bg-gray-50',
};

const signalLabels: Record<string, string> = {
  high: 'High Signal',
  helpful: 'Helpful',
  skip: 'Skip',
};

const sectionNav = [
  { id: 'role-snapshot', label: 'Role Snapshot' },
  { id: 'what-you-have', label: 'What You Already Have' },
  { id: 'learning-path', label: 'The Learning Path' },
  { id: 'certifications', label: 'Certifications' },
  { id: 'portfolio-projects', label: 'Portfolio Projects' },
  { id: 'transition-stories', label: 'Transition Stories' },
  { id: 'first-moves', label: 'First Three Moves' },
];
---

<BaseLayout
  title={`${meta.title} | Health Tech Career Roadmaps`}
  description={meta.shortDescription}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 lg:py-12">

    <!-- Back to all roadmaps -->
    <a href="/" class="inline-flex items-center gap-2 text-sm font-medium text-gray-500 hover:text-green-700 transition-colors mb-8">
      <span>&larr;</span> All Roadmaps
    </a>

    <!-- Mobile Section Nav -->
    <div class="lg:hidden mb-8 overflow-x-auto -mx-4 px-4 pb-2">
      <nav class="flex gap-2 min-w-min">
        {sectionNav.map((s, i) => (
          <a
            href={`#${s.id}`}
            class="section-nav px-3 py-2 rounded-lg whitespace-nowrap text-xs font-medium border border-gray-200 text-gray-600 hover:border-green-600 hover:text-green-700 transition-colors"
            data-section={s.id}
          >
            {i + 1}. {s.label}
          </a>
        ))}
      </nav>
    </div>

    <!-- Grid: Sidebar + Content -->
    <div class="grid grid-cols-1 lg:grid-cols-[240px_1fr] gap-12">

      <!-- Sticky Sidebar (Desktop) -->
      <aside class="hidden lg:block">
        <div class="sticky top-24 space-y-6">
          <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Sections</p>
          <nav class="space-y-1">
            {sectionNav.map((s, i) => (
              <a
                href={`#${s.id}`}
                class="section-nav flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm text-gray-500 hover:text-green-700 hover:bg-green-50 border-l-3 border-transparent transition-all"
                data-section={s.id}
              >
                <span class="w-5 text-center text-xs text-gray-400">{i + 1}</span>
                {s.label}
              </a>
            ))}
          </nav>

          <div class="pt-4 border-t border-gray-100">
            <p class="text-xs text-gray-400 mb-2">Progress</p>
            <div class="flex gap-1">
              {sectionNav.map((s) => (
                <div class="progress-bar flex-1 h-1.5 rounded-full bg-gray-200 transition-colors" data-section={s.id}></div>
              ))}
            </div>
          </div>

          <a
            href="https://youtube.com/@ehoneah"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2.5 p-3 rounded-lg bg-gray-50 hover:bg-gray-100 transition-colors group"
          >
            <svg class="w-5 h-5 text-red-600 shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
            <span class="text-xs font-medium text-gray-600 group-hover:text-gray-900 transition-colors">Watch video guides</span>
          </a>
        </div>
      </aside>

      <!-- Main Content -->
      <main class="min-w-0 space-y-20">

        <!-- ==================== SECTION 1: ROLE SNAPSHOT ==================== -->
        <section id="role-snapshot" class="scroll-mt-24">
          <div class="space-y-8">
            <div class="flex items-start gap-5">
              <span class="text-5xl">{meta.icon}</span>
              <div>
                <h1 class="text-3xl sm:text-4xl font-bold text-gray-900">{meta.title}</h1>
                <p class="text-lg text-gray-500 mt-2">{sections.roleSnapshot.oneLiner}</p>
              </div>
            </div>

            <div class="flex flex-wrap gap-3">
              <span class={`px-4 py-1.5 rounded-full text-sm font-semibold ${difficultyColors[meta.difficulty]}`}>
                {meta.difficulty.replace('-', ' ').replace(/\b\w/g, (c: string) => c.toUpperCase())} Difficulty
              </span>
              <span class="px-4 py-1.5 rounded-full text-sm font-semibold bg-blue-50 text-blue-700">
                {meta.timeline}
              </span>
            </div>

            <!-- Best Suited For -->
            <div class="p-6 rounded-xl bg-green-50 border border-green-200">
              <p class="text-sm font-semibold text-green-800 mb-2">Best Suited For</p>
              <p class="text-gray-700 leading-relaxed">{sections.roleSnapshot.bestSuitedFor}</p>
            </div>

            <!-- Key Info Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="p-5 rounded-lg border border-gray-200">
                <p class="text-xs font-semibold text-gray-400 uppercase mb-2">Work Setting</p>
                <p class="text-sm text-gray-700">{sections.roleSnapshot.workSetting}</p>
              </div>
              <div class="p-5 rounded-lg border border-gray-200">
                <p class="text-xs font-semibold text-gray-400 uppercase mb-2">Demand</p>
                <p class="text-sm text-gray-700">{sections.roleSnapshot.demandSignal}</p>
              </div>
            </div>

            <!-- Key Differentiator -->
            {sections.roleSnapshot.keyDifferentiator && (
              <div class="p-5 rounded-lg border-l-4 border-green-500 bg-gray-50">
                <p class="text-sm font-semibold text-gray-900 mb-1">Key Differentiator</p>
                <p class="text-sm text-gray-700">{sections.roleSnapshot.keyDifferentiator}</p>
              </div>
            )}

            <!-- Where They Work -->
            <div>
              <p class="text-sm font-semibold text-gray-900 mb-3">Where They Work</p>
              <div class="flex flex-wrap gap-2">
                {sections.roleSnapshot.whereTheyWork.map((place: string) => (
                  <span class="px-3 py-1.5 text-xs bg-gray-100 text-gray-700 rounded-full">{place}</span>
                ))}
              </div>
            </div>

            <!-- Clinical Advantages -->
            <div>
              <p class="text-sm font-semibold text-gray-900 mb-3">Why Your Clinical Background Matters</p>
              <ul class="space-y-2">
                {sections.roleSnapshot.clinicalAdvantage.map((adv: string) => (
                  <li class="flex items-start gap-3 text-sm text-gray-700">
                    <span class="text-green-600 mt-0.5 shrink-0">&#10003;</span>
                    <span>{adv}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </section>

        <!-- ==================== SECTION 2: WHAT YOU ALREADY HAVE ==================== -->
        <section id="what-you-have" class="scroll-mt-24">
          <h2 class="text-2xl font-bold text-gray-900 mb-8">What You Already Have</h2>

          <!-- Tabs -->
          <div class="border-b border-gray-200 mb-8">
            <nav class="flex gap-6" id="skill-tabs">
              <button class="skill-tab pb-3 text-sm font-semibold border-b-2 border-green-600 text-green-700" data-tab="nurses">Nurses</button>
              <button class="skill-tab pb-3 text-sm font-semibold border-b-2 border-transparent text-gray-500 hover:text-gray-700" data-tab="pharmacists">Pharmacists</button>
              <button class="skill-tab pb-3 text-sm font-semibold border-b-2 border-transparent text-gray-500 hover:text-gray-700" data-tab="other">Other Clinicians</button>
            </nav>
          </div>

          <!-- Tab Panels -->
          {(['nurses', 'pharmacists', 'otherClinicians'] as const).map((group, gi) => {
            const tabKey = group === 'otherClinicians' ? 'other' : group;
            return (
              <div class={`skill-panel space-y-4 ${gi === 0 ? '' : 'hidden'}`} data-panel={tabKey}>
                {sections.whatYouAlreadyHave[group].map((skill) => (
                  <div class="p-5 rounded-lg border border-gray-200 hover:border-green-200 transition-colors">
                    <div class="flex items-center gap-3 mb-2">
                      <span class="text-sm font-semibold text-gray-900">{skill.clinical}</span>
                      <span class="text-green-600 shrink-0">&rarr;</span>
                      <span class="text-sm font-semibold text-green-700">{skill.tech}</span>
                    </div>
                    <p class="text-sm text-gray-600 leading-relaxed">{skill.explanation}</p>
                  </div>
                ))}
              </div>
            );
          })}
        </section>

        <!-- ==================== SECTION 3: LEARNING PATH ==================== -->
        <section id="learning-path" class="scroll-mt-24">
          <h2 class="text-2xl font-bold text-gray-900 mb-2">The Learning Path</h2>
          <p class="text-sm text-gray-500 mb-8">Total timeline: {sections.learningPath.totalTimeline}</p>

          <div class="space-y-6">
            {sections.learningPath.phases.map((phase, i) => (
              <div class="relative pl-8 border-l-2 border-green-200">
                <div class="absolute -left-3 top-0 w-6 h-6 rounded-full bg-green-600 text-white text-xs font-bold flex items-center justify-center">
                  {i + 1}
                </div>
                <div class="p-6 rounded-lg border border-gray-200 bg-white">
                  <div class="flex items-start justify-between mb-3">
                    <h3 class="text-lg font-semibold text-gray-900">{phase.name}</h3>
                    <div class="flex gap-2 shrink-0">
                      <span class="px-2.5 py-1 text-xs bg-blue-50 text-blue-700 rounded-full">{phase.weeks}</span>
                      <span class="px-2.5 py-1 text-xs bg-gray-100 text-gray-600 rounded-full">{phase.hours}</span>
                    </div>
                  </div>

                  <div class="mb-4">
                    <p class="text-xs font-semibold text-gray-400 uppercase mb-2">Topics</p>
                    <div class="flex flex-wrap gap-2">
                      {phase.topics.map((topic: string) => (
                        <span class="px-2.5 py-1 text-xs bg-gray-50 text-gray-700 rounded border border-gray-200">{topic}</span>
                      ))}
                    </div>
                  </div>

                  <div class="mb-4">
                    <p class="text-xs font-semibold text-gray-400 uppercase mb-2">Resources</p>
                    <ul class="space-y-1.5">
                      {phase.resources.map((r) => (
                        <li class="flex items-center gap-2 text-sm">
                          <span class={`px-1.5 py-0.5 text-[10px] font-bold rounded ${r.free ? 'bg-green-100 text-green-700' : 'bg-amber-100 text-amber-700'}`}>
                            {r.free ? 'FREE' : 'PAID'}
                          </span>
                          <a href={r.url} target="_blank" rel="noopener noreferrer" class="text-green-700 hover:underline">
                            {r.name}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>

                  <div class="p-3 rounded-lg bg-gray-50">
                    <p class="text-xs font-semibold text-gray-500 mb-1">Checkpoint</p>
                    <p class="text-sm text-gray-700">{phase.checkpoint}</p>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- Email Capture (Mid-page) -->
        <EmailCapture client:visible roadmapSlug={meta.slug} roleTitle={meta.title} position="mid" />

        <!-- ==================== SECTION 4: CERTIFICATIONS ==================== -->
        <section id="certifications" class="scroll-mt-24">
          <h2 class="text-2xl font-bold text-gray-900 mb-4">Certifications</h2>

          <!-- Reality Check -->
          <div class="p-5 rounded-xl bg-amber-50 border border-amber-200 mb-8">
            <p class="text-sm font-semibold text-amber-800 mb-1">Reality Check</p>
            <p class="text-sm text-amber-700">{sections.certifications.realityCheck}</p>
          </div>

          <!-- Grouped by signal -->
          {(['high', 'helpful', 'skip'] as const).map((signal) => {
            const certs = sections.certifications.items.filter((c) => c.signal === signal);
            if (certs.length === 0) return null;
            return (
              <div class="mb-8">
                <h3 class="text-sm font-semibold text-gray-900 mb-4 flex items-center gap-2">
                  <span class={`w-3 h-3 rounded-full ${signal === 'high' ? 'bg-emerald-500' : signal === 'helpful' ? 'bg-amber-500' : 'bg-gray-400'}`}></span>
                  {signalLabels[signal]}
                </h3>
                <div class="space-y-3">
                  {certs.map((cert) => (
                    <div class={`p-5 rounded-lg border ${signalColors[signal]}`}>
                      <div class="flex items-start justify-between mb-2">
                        <p class="font-semibold text-gray-900">{cert.name}</p>
                        <span class="text-xs text-gray-500 shrink-0">{cert.frequency}</span>
                      </div>
                      <div class="flex gap-4 text-xs text-gray-500 mb-2">
                        <span>Cost: {cert.cost}</span>
                        <span>Timeline: {cert.timeline}</span>
                      </div>
                      <p class="text-sm text-gray-600">{cert.notes}</p>
                    </div>
                  ))}
                </div>
              </div>
            );
          })}

          {sections.certifications.recommendation && (
            <div class="p-5 rounded-lg border-l-4 border-green-500 bg-gray-50">
              <p class="text-sm font-semibold text-gray-900 mb-1">Recommendation</p>
              <p class="text-sm text-gray-700">{sections.certifications.recommendation}</p>
            </div>
          )}
        </section>

        <!-- ==================== SECTION 5: PORTFOLIO PROJECTS ==================== -->
        <section id="portfolio-projects" class="scroll-mt-24">
          <h2 class="text-2xl font-bold text-gray-900 mb-8">Portfolio Projects</h2>

          <div class="space-y-6">
            {sections.portfolioProjects.map((project, i) => (
              <div class="p-6 rounded-lg border border-gray-200">
                <div class="flex items-start gap-4 mb-4">
                  <span class="w-8 h-8 rounded-full bg-green-600 text-white text-sm font-bold flex items-center justify-center shrink-0">{i + 1}</span>
                  <div>
                    <h3 class="text-lg font-semibold text-gray-900">{project.title}</h3>
                    <span class="text-xs text-gray-500">{project.timeEstimate}</span>
                  </div>
                </div>
                <p class="text-sm text-gray-700 mb-4">{project.description}</p>

                <div class="flex flex-wrap gap-2 mb-4">
                  {project.tools.map((tool: string) => (
                    <span class="px-2.5 py-1 text-xs bg-gray-100 text-gray-700 rounded">{tool}</span>
                  ))}
                </div>

                {project.datasetUrl && (
                  <p class="text-sm mb-3">
                    <span class="text-gray-500">Dataset: </span>
                    <a href={project.datasetUrl} target="_blank" rel="noopener noreferrer" class="text-green-700 hover:underline">{project.dataset || 'View dataset'}</a>
                  </p>
                )}

                <div class="p-3 rounded-lg bg-green-50">
                  <p class="text-xs font-semibold text-green-800 mb-1">Your Clinical Advantage</p>
                  <p class="text-sm text-green-700">{project.clinicalAdvantage}</p>
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- ==================== SECTION 6: TRANSITION STORIES ==================== -->
        <section id="transition-stories" class="scroll-mt-24">
          <h2 class="text-2xl font-bold text-gray-900 mb-8">Real Transition Stories</h2>

          {sections.transitionStories.verified.length > 0 ? (
            <div class="space-y-4 mb-8">
              {sections.transitionStories.verified.map((story) => (
                <div class="group rounded-lg border border-gray-200 hover:border-green-200 hover:shadow-md transition-all overflow-hidden">
                  <a href={`/stories/${story.slug}`} class="block p-6">
                    <div class="flex items-start justify-between gap-4 mb-1">
                      <h3 class="font-semibold text-gray-900 text-lg group-hover:text-green-700 transition-colors">{story.name}</h3>
                      <div class="flex items-center gap-2 shrink-0">
                        {story.transitionTimeline && (
                          <span class="px-2 py-0.5 text-xs bg-blue-50 text-blue-700 rounded-full">{story.transitionTimeline}</span>
                        )}
                        {story.linkedinUrl && (
                          <svg class="w-4 h-4 text-gray-400" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                        )}
                      </div>
                    </div>
                    <p class="text-sm text-gray-500 mb-3">
                      {story.previousRole} &rarr; {story.currentTitle} at {story.company}
                    </p>
                    <p class="text-sm text-gray-700 mb-3 line-clamp-2">{story.summary}</p>
                    <span class="text-sm font-medium text-green-700 group-hover:translate-x-1 transition-transform inline-block">
                      Read full story &rarr;
                    </span>
                  </a>
                </div>
              ))}
            </div>
          ) : null}

          <div class="p-6 rounded-xl bg-gradient-to-br from-green-50 to-emerald-50 border border-green-200">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-full bg-green-100 flex items-center justify-center shrink-0">
                <span class="text-green-600 text-lg">&#9997;</span>
              </div>
              <div>
                <h3 class="font-semibold text-gray-900 mb-1">Made this transition yourself?</h3>
                <p class="text-sm text-gray-600 mb-4">
                  Share your story and help the next person take the leap. No GitHub needed. Just a simple form with your experience. Verified stories get featured right here with full credit.
                </p>
                <a
                  href="/contribute"
                  class="inline-flex items-center gap-2 px-5 py-2.5 bg-green-600 hover:bg-green-700 text-white text-sm font-medium rounded-lg transition-colors"
                >
                  Share Your Story &rarr;
                </a>
              </div>
            </div>
          </div>
        </section>

        <!-- YouTube CTA Banner -->
        <div class="p-6 rounded-xl bg-gray-50 border border-gray-200 flex items-start gap-4">
          <svg class="w-8 h-8 text-red-600 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
          </svg>
          <div>
            <h3 class="font-semibold text-gray-900 mb-1">See more transitions on YouTube</h3>
            <p class="text-sm text-gray-600 mb-3">Watch video guides, real transition stories, and tutorials from healthcare professionals who made the switch to tech.</p>
            <a
              href="https://youtube.com/@ehoneah"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 text-sm font-medium text-red-600 hover:text-red-700 transition-colors"
            >
              Visit the channel &rarr;
            </a>
          </div>
        </div>

        <!-- ==================== SECTION 7: FIRST THREE MOVES ==================== -->
        <section id="first-moves" class="scroll-mt-24">
          <h2 class="text-2xl font-bold text-gray-900 mb-2">First Three Moves</h2>
          <p class="text-sm text-gray-500 mb-8">Start this week. No prerequisites.</p>

          <div class="space-y-6">
            {sections.firstThreeMoves.map((move, i) => (
              <div class="p-6 rounded-lg border-2 border-gray-200 hover:border-green-300 transition-colors">
                <div class="flex items-start gap-4 mb-4">
                  <span class="w-10 h-10 rounded-full bg-green-600 text-white text-lg font-bold flex items-center justify-center shrink-0">{i + 1}</span>
                  <div>
                    <h3 class="text-lg font-semibold text-gray-900">{move.title}</h3>
                    <span class="text-xs font-medium text-green-700 bg-green-50 px-2 py-0.5 rounded">{move.timeEstimate}</span>
                  </div>
                </div>
                <p class="text-sm text-gray-700 mb-4">{move.description}</p>
                {move.specifics.length > 0 && (
                  <ul class="space-y-1.5">
                    {move.specifics.map((s: string) => (
                      <li class="flex items-start gap-2 text-sm text-gray-600">
                        <span class="text-green-500 mt-0.5 shrink-0">&#8226;</span>
                        <span>{s}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            ))}
          </div>
        </section>

        <!-- Email Capture (End) -->
        <EmailCapture client:visible roadmapSlug={meta.slug} roleTitle={meta.title} position="end" />

        <!-- Sources -->
        <section class="pt-8 border-t border-gray-200">
          <details class="group">
            <summary class="text-sm font-semibold text-gray-500 cursor-pointer hover:text-gray-700">
              Sources ({sources.length})
            </summary>
            <ul class="mt-4 space-y-1">
              {sources.map((url: string) => (
                <li>
                  <a href={url} target="_blank" rel="noopener noreferrer" class="text-xs text-green-700 hover:underline break-all">{url}</a>
                </li>
              ))}
            </ul>
          </details>
        </section>

      </main>
    </div>
  </div>

  <!-- Client-side: IntersectionObserver for active section + tab switching -->
  <script>
    // Section scroll tracking
    const sections = document.querySelectorAll('section[id]');
    const navLinks = document.querySelectorAll('.section-nav');
    const progressBars = document.querySelectorAll('.progress-bar');

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const id = entry.target.id;
          if (entry.isIntersecting) {
            navLinks.forEach((link) => {
              const isActive = link.getAttribute('data-section') === id;
              link.classList.toggle('text-green-700', isActive);
              link.classList.toggle('bg-green-50', isActive);
              link.classList.toggle('!border-green-600', isActive);
              link.classList.toggle('text-gray-500', !isActive);
            });
            progressBars.forEach((bar) => {
              const barSection = bar.getAttribute('data-section');
              if (barSection) {
                const sectionIndex = Array.from(sections).findIndex((s) => s.id === barSection);
                const activeIndex = Array.from(sections).findIndex((s) => s.id === id);
                bar.classList.toggle('!bg-green-500', sectionIndex <= activeIndex);
              }
            });
          }
        });
      },
      { rootMargin: '-20% 0px -70% 0px' }
    );

    sections.forEach((section) => observer.observe(section));

    // Skill translation tabs
    const tabs = document.querySelectorAll('.skill-tab');
    const panels = document.querySelectorAll('.skill-panel');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-tab');
        tabs.forEach((t) => {
          t.classList.toggle('border-green-600', t === tab);
          t.classList.toggle('text-green-700', t === tab);
          t.classList.toggle('border-transparent', t !== tab);
          t.classList.toggle('text-gray-500', t !== tab);
        });
        panels.forEach((p) => {
          p.classList.toggle('hidden', p.getAttribute('data-panel') !== target);
        });
      });
    });
  </script>
</BaseLayout>
