---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Something Went Wrong | Health Tech Career Roadmaps"
  description="An unexpected error occurred. Please try again or return to the homepage."
>
  <section class="px-6 py-24 md:py-32 flex items-center justify-center min-h-[60vh]">
    <div class="max-w-xl mx-auto text-center">
      <!-- Wrench SVG Icon -->
      <div class="mb-8 flex justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="url(#wrench-gradient)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <defs>
            <linearGradient id="wrench-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#22c55e" />
              <stop offset="100%" stop-color="#16a34a" />
            </linearGradient>
          </defs>
          <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" fill="url(#wrench-gradient)" opacity="0.2" />
        </svg>
      </div>

      <!-- 500 Heading -->
      <h1 class="text-7xl md:text-8xl font-bold mb-4 bg-gradient-to-br from-brand-500 to-brand-600 bg-clip-text text-transparent">
        500
      </h1>

      <!-- Message -->
      <p class="text-2xl md:text-3xl font-semibold text-surface-900 mb-3">
        Something went wrong on our end
      </p>
      <p class="text-lg text-surface-600 mb-10">
        We hit an unexpected error. Please try again in a moment, or head back to the homepage.
      </p>

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/"
          class="px-6 py-3 bg-brand-600 hover:bg-brand-700 text-white font-medium rounded-lg transition-colors"
        >
          Go to Homepage
        </a>
        <button
          onclick="window.location.reload()"
          class="px-6 py-3 text-brand-600 hover:text-brand-700 font-medium rounded-lg border border-surface-200 hover:border-surface-300 transition-colors cursor-pointer"
        >
          Refresh Page
        </button>
      </div>
    </div>
  </section>
</BaseLayout>
