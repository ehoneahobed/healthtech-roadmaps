---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllRoadmapMeta } from '../lib/roadmaps';
import RoadmapExplorer from '../components/RoadmapExplorer';

const roadmaps = getAllRoadmapMeta();
---

<BaseLayout
  title="Health Tech Career Roadmaps"
  description="Research-backed transition guides for healthcare professionals moving into tech."
>
  <!-- Hero Section -->
  <section class="pt-20 pb-14 px-6 md:pt-28 md:pb-20 bg-gradient-to-b from-brand-50/60 to-white">
    <div class="max-w-5xl mx-auto text-center">
      <p class="inline-block text-sm font-medium text-brand-700 bg-brand-100 px-4 py-1.5 rounded-full mb-6">
        Built by a pharmacist who made the switch
      </p>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-surface-900 mb-6 leading-tight">
        Your roadmap from <span class="text-brand-600">clinical</span> to <span class="text-brand-600">tech</span>
      </h1>
      <p class="text-lg md:text-xl text-surface-600 mb-10 max-w-2xl mx-auto leading-relaxed">
        Research-backed transition guides with realistic timelines, real stories, and actionable first moves. No fluff.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-6 text-sm text-surface-600">
        <div class="flex items-center gap-2">
          <span class="w-8 h-8 rounded-lg bg-brand-100 flex items-center justify-center text-brand-600 font-bold text-xs">7+</span>
          <span>Career paths</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="w-8 h-8 rounded-lg bg-emerald-100 flex items-center justify-center text-emerald-600 font-bold text-xs">&#10003;</span>
          <span>100% free</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="w-8 h-8 rounded-lg bg-amber-100 flex items-center justify-center text-amber-600 font-bold text-xs">&#9783;</span>
          <span>Research-backed</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Roadmap Cards -->
  <section class="px-6 pb-24">
    <div class="max-w-7xl mx-auto">
      <RoadmapExplorer roadmaps={roadmaps} client:load />
    </div>
  </section>

  <!-- How This Works Section -->
  <section class="px-6 py-24 bg-surface-50">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-surface-900 mb-4 text-center">
        How This Works
      </h2>
      <p class="text-lg text-surface-600 text-center mb-16 max-w-2xl mx-auto">
        Every roadmap follows the same research-backed framework, tailored to your specific role.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="flex gap-4">
          <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-brand-100 flex items-center justify-center">
            <span class="text-brand-600 font-bold">1</span>
          </div>
          <div>
            <h3 class="font-semibold text-surface-900 mb-2">Role Snapshot</h3>
            <p class="text-sm text-surface-600">
              Understand the role, who it suits, where people work, and your clinical advantage.
            </p>
          </div>
        </div>

        <div class="flex gap-4">
          <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-brand-100 flex items-center justify-center">
            <span class="text-brand-600 font-bold">2</span>
          </div>
          <div>
            <h3 class="font-semibold text-surface-900 mb-2">What You Already Have</h3>
            <p class="text-sm text-surface-600">
              See exactly how your clinical skills translate to tech competencies.
            </p>
          </div>
        </div>

        <div class="flex gap-4">
          <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-brand-100 flex items-center justify-center">
            <span class="text-brand-600 font-bold">3</span>
          </div>
          <div>
            <h3 class="font-semibold text-surface-900 mb-2">Learning Path</h3>
            <p class="text-sm text-surface-600">
              Phased curriculum with timelines, hours per week, topics, and curated resources.
            </p>
          </div>
        </div>

        <div class="flex gap-4">
          <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-brand-100 flex items-center justify-center">
            <span class="text-brand-600 font-bold">4</span>
          </div>
          <div>
            <h3 class="font-semibold text-surface-900 mb-2">Certifications</h3>
            <p class="text-sm text-surface-600">
              Real talk on which certs actually matter for your role and hiring managers.
            </p>
          </div>
        </div>

        <div class="flex gap-4">
          <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-brand-100 flex items-center justify-center">
            <span class="text-brand-600 font-bold">5</span>
          </div>
          <div>
            <h3 class="font-semibold text-surface-900 mb-2">Portfolio Projects</h3>
            <p class="text-sm text-surface-600">
              Specific projects that showcase your clinical understanding plus tech skills.
            </p>
          </div>
        </div>

        <div class="flex gap-4">
          <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-brand-100 flex items-center justify-center">
            <span class="text-brand-600 font-bold">6</span>
          </div>
          <div>
            <h3 class="font-semibold text-surface-900 mb-2">Transition Stories</h3>
            <p class="text-sm text-surface-600">
              Real people who made the transition, their timelines, and how they did it.
            </p>
          </div>
        </div>

        <div class="flex gap-4 md:col-span-2 md:max-w-sm">
          <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-brand-100 flex items-center justify-center">
            <span class="text-brand-600 font-bold">7</span>
          </div>
          <div>
            <h3 class="font-semibold text-surface-900 mb-2">First Three Moves</h3>
            <p class="text-sm text-surface-600">
              Actionable steps you can take this week to start your transition.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="px-6 py-24">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-surface-900 mb-6">
        Ready to make the move?
      </h2>
      <p class="text-lg text-surface-600 mb-8">
        Choose your role above to get the complete action kit. Everything you need to transition successfully.
      </p>
      <p class="text-sm text-surface-500">
        Questions? Join <a href="https://thetransmutation.substack.com" target="_blank" rel="noopener noreferrer" class="text-brand-600 hover:text-brand-700 transition-colors">The Transmutation newsletter</a> for weekly insights on healthcare to tech transitions.
      </p>
    </div>
  </section>
</BaseLayout>
