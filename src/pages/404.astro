---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found | Health Tech Career Roadmaps"
  description="The page you're looking for doesn't exist. Browse our health tech career roadmaps instead."
>
  <section class="px-6 py-24 md:py-32 flex items-center justify-center min-h-[60vh]">
    <div class="max-w-xl mx-auto text-center">
      <!-- Compass/Map SVG Icon -->
      <div class="mb-8 flex justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="url(#compass-gradient)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <defs>
            <linearGradient id="compass-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#22c55e" />
              <stop offset="100%" stop-color="#16a34a" />
            </linearGradient>
          </defs>
          <circle cx="12" cy="12" r="10" />
          <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76" fill="url(#compass-gradient)" opacity="0.2" stroke="url(#compass-gradient)" />
        </svg>
      </div>

      <!-- 404 Heading -->
      <h1 class="text-7xl md:text-8xl font-bold mb-4 bg-gradient-to-br from-brand-500 to-brand-600 bg-clip-text text-transparent">
        404
      </h1>

      <!-- Message -->
      <p class="text-2xl md:text-3xl font-semibold text-surface-900 mb-3">
        This page took a wrong turn
      </p>
      <p class="text-lg text-surface-600 mb-10">
        The page you're looking for doesn't exist or may have been moved. Let's get you back on track.
      </p>

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/"
          class="px-6 py-3 bg-brand-600 hover:bg-brand-700 text-white font-medium rounded-lg transition-colors"
        >
          Browse All Roadmaps
        </a>
      </div>
      <p class="mt-6 text-sm text-surface-500">
        You might also want to double-check the URL for typos.
      </p>
    </div>
  </section>
</BaseLayout>
