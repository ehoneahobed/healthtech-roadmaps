---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EmailCapture from '../../components/EmailCapture.tsx';
import { getAllStories } from '../../lib/roadmaps';
import type { StoryWithContext } from '../../lib/roadmaps';

export const prerender = true;

export function getStaticPaths() {
  const stories = getAllStories();
  if (stories.length === 0) {
    return [];
  }
  return stories.map((story) => ({
    params: { slug: story.slug },
    props: { story },
  }));
}

const { story } = Astro.props as { story: StoryWithContext };
if (!story) {
  return Astro.redirect('/stories');
}

const allStories = getAllStories();
const relatedStories = allStories
  .filter(s => s.slug !== story.slug && s.roadmapSlug === story.roadmapSlug)
  .slice(0, 3);

const otherStories = relatedStories.length < 2
  ? allStories.filter(s => s.slug !== story.slug && s.roadmapSlug !== story.roadmapSlug).slice(0, 3 - relatedStories.length)
  : [];

const seoTitle = `${story.name}: ${story.previousRole} to ${story.currentTitle} | Transition Story`;
const seoDescription = story.summary.length > 155
  ? story.summary.substring(0, 152) + '...'
  : story.summary;

// JSON-LD structured data
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": `How ${story.name} Went from ${story.previousRole} to ${story.currentTitle}`,
  "description": story.summary,
  "author": {
    "@type": "Person",
    "name": story.name,
    ...(story.linkedinUrl ? { "url": story.linkedinUrl } : {}),
  },
  "publisher": {
    "@type": "Organization",
    "name": "Health Tech Roadmaps by Ehoneah",
    "url": "https://roadmaps.tarvra.com",
  },
  ...(story.publishedDate ? { "datePublished": story.publishedDate } : {}),
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://roadmaps.tarvra.com/stories/${story.slug}`,
  },
});
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
>
  <Fragment slot="meta">
    <script type="application/ld+json" set:html={jsonLd} />
    <meta property="og:type" content="article" />
    <meta property="article:section" content="Career Transition Stories" />
  </Fragment>

  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 lg:py-12">

    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm text-gray-500 mb-8">
      <a href="/" class="hover:text-green-700 transition-colors">Roadmaps</a>
      <span>/</span>
      <a href="/stories" class="hover:text-green-700 transition-colors">Stories</a>
      <span>/</span>
      <span class="text-gray-900 font-medium">{story.name}</span>
    </nav>

    <!-- Hero -->
    <header class="mb-12">
      <div class="flex items-center gap-3 mb-6">
        <a
          href={`/r/${story.roadmapSlug}`}
          class="inline-flex items-center gap-2 px-3 py-1.5 text-xs font-medium bg-green-50 text-green-700 border border-green-200 rounded-full hover:bg-green-100 transition-colors"
        >
          <span>{story.roadmapIcon}</span>
          {story.roadmapTitle.replace(' Roadmap', '')}
        </a>
        {story.transitionTimeline && (
          <span class="px-3 py-1.5 text-xs font-medium bg-blue-50 text-blue-700 rounded-full">
            {story.transitionTimeline}
          </span>
        )}
      </div>

      <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4 leading-tight">
        How {story.name} Went from {story.previousRole} to {story.currentTitle}
      </h1>

      <div class="flex items-center gap-4 text-sm text-gray-500">
        <span>{story.previousRole} &rarr; {story.currentTitle}</span>
        {story.company && (
          <>
            <span class="w-1 h-1 rounded-full bg-gray-300"></span>
            <span>at {story.company}</span>
          </>
        )}
      </div>

      <div class="flex items-center gap-3 mt-4">
        {story.linkedinUrl && (
          <a
            href={story.linkedinUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-sm text-blue-600 hover:text-blue-700 transition-colors"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            Connect on LinkedIn
          </a>
        )}
        {story.sourceUrl && (
          <a
            href={story.sourceUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-sm text-green-700 hover:text-green-800 transition-colors"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
            Original source
          </a>
        )}
      </div>
    </header>

    <!-- Summary -->
    <div class="p-6 rounded-xl bg-green-50 border border-green-200 mb-12 space-y-4">
      {story.summary.split('\n\n').map((paragraph: string) => (
        <p class="text-gray-800 leading-relaxed text-base">{paragraph}</p>
      ))}
    </div>

    <!-- Detail Sections -->
    <div class="space-y-10">

      {story.skillsTransferred && (
        <section>
          <h2 class="text-xl font-bold text-gray-900 mb-3 flex items-center gap-3">
            <span class="w-8 h-8 rounded-lg bg-green-100 flex items-center justify-center text-green-600 text-sm shrink-0">&#10003;</span>
            Skills That Transferred
          </h2>
          <div class="pl-11">
            <p class="text-gray-700 leading-relaxed">{story.skillsTransferred}</p>
          </div>
        </section>
      )}

      {story.whatTheyLearned && (
        <section>
          <h2 class="text-xl font-bold text-gray-900 mb-3 flex items-center gap-3">
            <span class="w-8 h-8 rounded-lg bg-blue-100 flex items-center justify-center text-blue-600 text-sm shrink-0">&#128218;</span>
            What They Had to Learn
          </h2>
          <div class="pl-11">
            <p class="text-gray-700 leading-relaxed">{story.whatTheyLearned}</p>
          </div>
        </section>
      )}

      {story.resourcesThatHelped && (
        <section>
          <h2 class="text-xl font-bold text-gray-900 mb-3 flex items-center gap-3">
            <span class="w-8 h-8 rounded-lg bg-amber-100 flex items-center justify-center text-amber-600 text-sm shrink-0">&#128279;</span>
            Resources That Helped
          </h2>
          <div class="pl-11">
            <p class="text-gray-700 leading-relaxed">{story.resourcesThatHelped}</p>
          </div>
        </section>
      )}

      {story.whatSurprisedThem && (
        <section>
          <h2 class="text-xl font-bold text-gray-900 mb-3 flex items-center gap-3">
            <span class="w-8 h-8 rounded-lg bg-purple-100 flex items-center justify-center text-purple-600 text-sm shrink-0">&#128161;</span>
            What Surprised Them
          </h2>
          <div class="pl-11">
            <p class="text-gray-700 leading-relaxed">{story.whatSurprisedThem}</p>
          </div>
        </section>
      )}

      {story.adviceForOthers && (
        <section>
          <h2 class="text-xl font-bold text-gray-900 mb-3 flex items-center gap-3">
            <span class="w-8 h-8 rounded-lg bg-green-100 flex items-center justify-center text-green-600 text-sm shrink-0">&#128172;</span>
            Their Advice
          </h2>
          <div class="pl-11">
            <div class="p-5 rounded-lg bg-green-50 border border-green-200">
              <p class="text-green-800 leading-relaxed italic">{story.adviceForOthers}</p>
            </div>
          </div>
        </section>
      )}
    </div>

    <!-- Roadmap CTA -->
    <div class="mt-16 p-6 rounded-xl border-2 border-green-200 bg-gradient-to-br from-green-50 to-emerald-50">
      <div class="flex items-start gap-4">
        <span class="text-3xl">{story.roadmapIcon}</span>
        <div>
          <h3 class="font-semibold text-gray-900 mb-2">
            Interested in becoming a {story.currentTitle}?
          </h3>
          <p class="text-sm text-gray-600 mb-4">
            See the complete roadmap with learning paths, certifications, portfolio projects, and more transition stories.
          </p>
          <a
            href={`/r/${story.roadmapSlug}`}
            class="inline-flex items-center gap-2 px-5 py-2.5 bg-green-600 hover:bg-green-700 text-white text-sm font-medium rounded-lg transition-colors"
          >
            View the {story.roadmapTitle.replace(' Roadmap', '')} Roadmap &rarr;
          </a>
        </div>
      </div>
    </div>

    <!-- Email Capture -->
    <EmailCapture client:visible roadmapSlug={story.roadmapSlug} roleTitle={story.roadmapTitle.replace(' Roadmap', '')} position="end" />

    <!-- Related Stories -->
    {(relatedStories.length > 0 || otherStories.length > 0) && (
      <section class="mt-16">
        <h2 class="text-2xl font-bold text-gray-900 mb-6">More Transition Stories</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {[...relatedStories, ...otherStories].map((s) => (
            <a
              href={`/stories/${s.slug}`}
              class="group block p-5 rounded-lg border border-gray-200 hover:border-green-200 hover:shadow-md transition-all"
            >
              <div class="flex items-center gap-2 mb-3">
                <span class="text-lg">{s.roadmapIcon}</span>
                <span class="text-xs text-gray-500">{s.roadmapTitle.replace(' Roadmap', '')}</span>
              </div>
              <h3 class="font-semibold text-gray-900 group-hover:text-green-700 transition-colors mb-1">
                {s.name}
              </h3>
              <p class="text-sm text-gray-500 mb-2">
                {s.previousRole} &rarr; {s.currentTitle}
              </p>
              <p class="text-sm text-gray-600 line-clamp-2">{s.summary}</p>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Contribute CTA -->
    <div class="mt-12 p-6 rounded-xl bg-gray-50 border border-gray-200 text-center">
      <h3 class="font-semibold text-gray-900 mb-2">Made a similar transition?</h3>
      <p class="text-sm text-gray-600 mb-4">
        Your story helps the next person take the leap. Share it in 5 minutes.
      </p>
      <a
        href="/contribute"
        class="inline-flex items-center gap-2 px-5 py-2.5 bg-green-600 hover:bg-green-700 text-white text-sm font-medium rounded-lg transition-colors"
      >
        Share Your Story &rarr;
      </a>
    </div>

  </article>
</BaseLayout>
